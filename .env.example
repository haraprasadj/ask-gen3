# Copy to .env (gitignored) and fill in. Loaded by every just recipe.

# Which slot is live. `just run` forces local; `just run-prod` and Cloud Run
# use hosted. Each slot owns the three variables under it and nothing is
# shared, so switching cannot half-apply. Any OpenAI-compatible endpoint works
# in either slot.
PROVIDER=local

# Local: Ollama by default. The model must be tool-capable, and a tag name says
# nothing about size — `ollama show <tag>` does. Ollama takes no key.
LOCAL_INFERENCE_URL=http://localhost:11434/v1
LOCAL_INFERENCE_MODEL=qwen3:8b
# LOCAL_INFERENCE_API_KEY=

# Hosted: OpenRouter by default. The key is the only real secret: create it at
# https://openrouter.ai/keys and set a hard spend limit on the key itself —
# that ceiling is the one an attacker with a working request cannot exceed.
HOSTED_INFERENCE_API_KEY=
# HOSTED_INFERENCE_URL=https://openrouter.ai/api/v1
# HOSTED_INFERENCE_MODEL=google/gemini-3.1-flash-lite   # benchmarked default, ADR-0007
# HOSTED_INFERENCE_MODEL=openrouter/free                # zero-cost, quality varies

# Optional server limits; defaults in README.
# RATE_LIMIT_PER_HOUR=20
# DAILY_QUESTION_CAP=2000
# REQUEST_TIMEOUT_SECONDS=120

# Who OpenRouter attributes requests to. Defaults to this repository; sent only
# when the hosted URL is OpenRouter.
# PUBLIC_URL=https://your-deployment.example

# Copy to .env (gitignored) and fill in. Loaded by every just recipe.

# Which provider is live. `just run` forces ollama; `just run-prod` and Cloud
# Run use openrouter. Each provider owns the three variables under it and
# nothing is shared, so switching cannot half-apply.
PROVIDER=ollama

# Local, via Ollama. The tag must be tool-capable, and a tag name says nothing
# about size — `ollama show <tag>` does. Ollama takes no key.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Hosted, via OpenRouter. The key is the only real secret: create it at
# https://openrouter.ai/keys and set a hard spend limit on the key itself —
# that ceiling is the one an attacker with a working request cannot exceed.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite   # benchmarked default, ADR-0007
# OPENROUTER_MODEL=openrouter/free                # zero-cost, quality varies

# Optional server limits; defaults in README.
# RATE_LIMIT_PER_HOUR=20
# DAILY_QUESTION_CAP=2000
# REQUEST_TIMEOUT_SECONDS=120

# Copy to .env (gitignored) and fill in. Loaded by `just run-prod`.

# The only real secret. Create at https://openrouter.ai/keys and set a hard
# spend limit on the key itself — that ceiling is the one an attacker with a
# working request cannot exceed.
OPENROUTER_API_KEY=

# Optional overrides; defaults in README.
# MODEL=google/gemini-3.1-flash-lite   # benchmarked default, see ADR-0007
# MODEL=openrouter/free                 # zero-cost, quality varies per request
# BASE_URL=https://openrouter.ai/api/v1
# RATE_LIMIT_PER_HOUR=20
# DAILY_QUESTION_CAP=2000
